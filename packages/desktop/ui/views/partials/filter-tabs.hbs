<menu class="tabs filter-tabs{{#if class}} {{class}}{{/if}}" role="tablist"{{#if label}} aria-label="{{label}}"{{/if}}>{{#each tabs as |tab|}}<li role="presentation"><button type="button" class="tab filter-tab" role="tab" data-action="filter" data-status="{{tab.status}}" aria-selected="{{#if tab.active}}true{{else}}false{{/if}}">{{#if tab.label}}{{tab.label}}{{else}}{{tab.status}}{{/if}}<span class="filter-tab-count{{#if (gt tab.count 99)}} filter-tab-count-wide{{/if}}">{{tab.count}}</span></button></li>{{/each}}</menu>
